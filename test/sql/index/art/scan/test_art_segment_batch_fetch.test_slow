# Base data is fetched in batches before committed updates are overlaid.
statement ok
UPDATE batch_fetch
SET packed_value = -packed_value,
    rle_value = -7,
    double_value = -double_value,
    dict_value = 'updated_dict',
    zstd_value = 'updated_zstd'
WHERE id BETWEEN 1000 AND 1099;

query IIIII
SELECT count(*), min(rle_value), max(rle_value), count(DISTINCT dict_value), count(DISTINCT zstd_value)
FROM batch_fetch
WHERE id BETWEEN 1000 AND 1099;
----
100	-7	-7	1	1

# Transaction-local UPDATE and DELETE visibility must be identical for Scan and ART.
statement ok
BEGIN;

statement ok
UPDATE batch_fetch
SET dict_value = 'transaction_dict', zstd_value = NULL
WHERE id BETWEEN 2000 AND 2099;

statement ok
DELETE FROM batch_fetch WHERE id IN (2001, 2003, 2005, 2007, 2009);

statement ok
SET index_scan_max_count = 0;

statement ok
SET index_scan_percentage = 0;

statement ok
CREATE TEMP TABLE expected_transaction AS
SELECT count(*) AS row_count,
       bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value)) AS row_hash,
       count(*) FILTER (WHERE zstd_value IS NULL) AS zstd_nulls
FROM batch_fetch
WHERE id BETWEEN 1950 AND 2150;

statement ok
SET index_scan_max_count = 300000;

statement ok
SET index_scan_percentage = 1.0;

query I
WITH actual AS (
    SELECT count(*) AS row_count,
           bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value)) AS row_hash,
           count(*) FILTER (WHERE zstd_value IS NULL) AS zstd_nulls
    FROM batch_fetch
    WHERE id BETWEEN 1950 AND 2150
)
SELECT actual.row_count = expected.row_count
       AND actual.row_hash = expected.row_hash
       AND actual.zstd_nulls = expected.zstd_nulls
FROM actual, expected_transaction expected;
----
true

statement ok
ROLLBACK;

query III
SELECT count(*), count(*) FILTER (WHERE dict_value = 'transaction_dict'),
       count(*) FILTER (WHERE zstd_value IS NULL)
FROM batch_fetch
WHERE id BETWEEN 2000 AND 2099;
----
100	0	5

# Mix transaction-local inserts with persisted rows returned by a non-unique ART.
statement ok
BEGIN;

statement ok
INSERT INTO batch_fetch VALUES
    (300001, 42, 1, 1, 1.5, 'local_dict_1', 'local_zstd_1'),
    (300002, 42, 2, 2, 2.5, NULL, NULL);

query IIII
SELECT count(*), count(*) FILTER (WHERE id > 300000), min(id), max(id)
FROM batch_fetch
WHERE group_key = 42;
----
3095	2	42	300002

query III
SELECT id, dict_value, zstd_value
FROM batch_fetch
WHERE group_key = 42 AND id > 300000
ORDER BY id;
----
300001	local_dict_1	local_zstd_1
300002	NULL	NULL

statement ok
ROLLBACK;

# Indexed DELETE uses FORCE_FETCH and must remain correct across many batches.
statement ok
DELETE FROM batch_fetch WHERE id BETWEEN 200000 AND 202500;

query III
SELECT count(*), count(*) FILTER (WHERE id = 199999), count(*) FILTER (WHERE id = 202501)
FROM batch_fetch
WHERE id BETWEEN 199999 AND 202501;
----
2	1	1

# Concurrent updates and reads must see one complete UpdateSegment version.
statement ok
UPDATE batch_fetch
SET packed_value = 0, rle_value = 0, double_value = 0,
    dict_value = 'concurrent_0', zstd_value = 'concurrent_0'
WHERE id BETWEEN 5000 AND 5099;

statement ok
SET GLOBAL index_scan_max_count = 300000;

statement ok
SET GLOBAL index_scan_percentage = 1.0;

concurrentloop threadid 0 5

loop i 0 20

onlyif threadid=0
statement ok
UPDATE batch_fetch
SET packed_value = {i} % 2,
    rle_value = {i} % 2,
    double_value = {i} % 2,
    dict_value = 'concurrent_' || ({i} % 2)::VARCHAR,
    zstd_value = 'concurrent_' || ({i} % 2)::VARCHAR
WHERE id BETWEEN 5000 AND 5099;

endloop

loop i 0 40

skipif threadid=0
query I
SELECT count(*) = 100
       AND count(DISTINCT hash(packed_value, rle_value, double_value, dict_value, zstd_value)) = 1
       AND bool_and(packed_value IN (0, 1)
                    AND rle_value = packed_value
                    AND double_value = packed_value
                    AND dict_value = 'concurrent_' || packed_value::VARCHAR
                    AND zstd_value = dict_value)
FROM batch_fetch
WHERE id BETWEEN 5000 AND 5099;
----
true

endloop

endloop

# Concurrent readers use thread-local scan state for dense, sparse, and task-boundary fetches.
statement ok
SET GLOBAL index_scan_max_count = 0;

statement ok
SET GLOBAL index_scan_percentage = 0;

statement ok
CREATE TABLE concurrent_expected (workload VARCHAR, row_count BIGINT, row_hash UBIGINT);

statement ok
INSERT INTO concurrent_expected
SELECT 'batch_2047' AS workload, count(*) AS row_count,
       bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value)) AS row_hash
FROM batch_fetch WHERE id <= 2047;

statement ok
INSERT INTO concurrent_expected
SELECT 'batch_2048', count(*),
       bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value))
FROM batch_fetch WHERE id <= 2048;

statement ok
INSERT INTO concurrent_expected
SELECT 'batch_2049', count(*),
       bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value))
FROM batch_fetch WHERE id <= 2049;

statement ok
INSERT INTO concurrent_expected
SELECT 'batch_sparse', count(*),
       bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value))
FROM batch_fetch WHERE group_key = 42 AND id <= 100000;

statement ok
INSERT INTO concurrent_expected
SELECT 'zstd_sparse', count(*), bit_xor(hash(id, lookup_key, payload))
FROM zstd_fetch WHERE lookup_key = 0;

statement ok
INSERT INTO concurrent_expected
SELECT 'alp_sparse', count(*), bit_xor(hash(id, lookup_key, payload_float, payload_double))
FROM alp_fetch WHERE lookup_key = 0;

statement ok
INSERT INTO concurrent_expected
SELECT 'alprd_sparse', count(*), bit_xor(hash(id, lookup_key, payload_float, payload_double))
FROM alprd_fetch WHERE lookup_key = 0;

statement ok
SET GLOBAL index_scan_max_count = 300000;

statement ok
SET GLOBAL index_scan_percentage = 1.0;

concurrentloop threadid 0 4

foreach upper_bound 2047 2048 2049

query I
WITH actual AS (
    SELECT count(*) AS row_count,
           bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value)) AS row_hash
    FROM batch_fetch WHERE id <= {upper_bound}
)
SELECT actual.row_count = expected.row_count AND actual.row_hash = expected.row_hash
FROM actual, concurrent_expected expected
WHERE expected.workload = 'batch_{upper_bound}';
----
true

endloop

query I
WITH actual AS (
    SELECT count(*) AS row_count,
           bit_xor(hash(id, group_key, packed_value, rle_value, double_value, dict_value, zstd_value)) AS row_hash
    FROM batch_fetch WHERE group_key = 42 AND id <= 100000
)
SELECT actual.row_count = expected.row_count AND actual.row_hash = expected.row_hash
FROM actual, concurrent_expected expected
WHERE expected.workload = 'batch_sparse';
----
true

query I
WITH actual AS (
    SELECT count(*) AS row_count, bit_xor(hash(id, lookup_key, payload)) AS row_hash
    FROM zstd_fetch WHERE lookup_key = 0
)
SELECT actual.row_count = expected.row_count AND actual.row_hash = expected.row_hash
FROM actual, concurrent_expected expected
WHERE expected.workload = 'zstd_sparse';
----
true

query I
WITH actual AS (
    SELECT count(*) AS row_count, bit_xor(hash(id, lookup_key, payload_float, payload_double)) AS row_hash
    FROM alp_fetch WHERE lookup_key = 0
)
SELECT actual.row_count = expected.row_count AND actual.row_hash = expected.row_hash
FROM actual, concurrent_expected expected
WHERE expected.workload = 'alp_sparse';
----
true

query I
WITH actual AS (
    SELECT count(*) AS row_count, bit_xor(hash(id, lookup_key, payload_float, payload_double)) AS row_hash
    FROM alprd_fetch WHERE lookup_key = 0
)
SELECT actual.row_count = expected.row_count AND actual.row_hash = expected.row_hash
FROM actual, concurrent_expected expected
WHERE expected.workload = 'alprd_sparse';
----
true

endloop
