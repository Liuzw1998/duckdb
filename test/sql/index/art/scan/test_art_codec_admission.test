# A large table with 128 ZSTD candidates exercises the rejecting path above the 64-row cap.
statement ok
PRAGMA force_compression = 'zstd'

statement ok
CREATE TABLE codec_medium_zstd(lookup_key INTEGER, residual VARCHAR, payload VARCHAR)

statement ok
INSERT INTO codec_medium_zstd
SELECT 42, CASE WHEN i = 1 THEN 'keep' ELSE 'reject' END, repeat('z', 4096)
FROM range(128) t(i)
UNION ALL
SELECT i % 41, 'reject', repeat('z', 128)
FROM range(99872) t(i)

statement ok
CHECKPOINT

statement ok
