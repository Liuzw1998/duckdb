# Same-column mixed codecs are checked by the candidate's actual segment, rather than the first segment.
statement ok
ATTACH '{TEMP_DIR}/codec_mixed.db' AS mixed (ROW_GROUP_SIZE 2048)

statement ok
USE mixed

statement ok
PRAGMA force_compression = 'uncompressed'

statement ok
CREATE TABLE mixed_codec(lookup_key INTEGER, residual VARCHAR, payload VARCHAR)

statement ok
INSERT INTO mixed_codec
SELECT 42, CASE WHEN i = 0 THEN 'keep' ELSE 'reject' END, repeat('a', 100)
FROM range(2048) t(i)

statement ok
FORCE CHECKPOINT

statement ok
PRAGMA force_compression = 'dict_fsst'

statement ok
INSERT INTO mixed_codec
SELECT 43, CASE WHEN i = 0 THEN 'keep' ELSE 'reject' END, repeat('b', 100)
FROM range(2048) t(i)
UNION ALL
SELECT i % 41, 'reject', repeat('c', 100)
FROM range(5904) t(i)

statement ok
FORCE CHECKPOINT

statement ok
CREATE INDEX mixed_codec_lookup ON mixed_codec(lookup_key)

query TT
SELECT DISTINCT compression, (row_group_id = 0)::VARCHAR FROM pragma_storage_info('mixed_codec')
WHERE column_name = 'residual' AND segment_type = 'VARCHAR' AND compression IN ('Uncompressed', 'DICT_FSST')
ORDER BY compression
----
DICT_FSST	false
Uncompressed	true

# The first row group is uncompressed and stays eligible at M=2048.
query II
EXPLAIN ANALYZE SELECT count(*) FROM mixed_codec WHERE lookup_key = 42 AND residual = 'keep'
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT count(*) FROM mixed_codec WHERE lookup_key = 42 AND residual = 'keep'
----
1

# The second row group is DICT_FSST and is rejected by the stricter admission.
query II
EXPLAIN ANALYZE SELECT count(*) FROM mixed_codec WHERE lookup_key = 43 AND residual = 'keep'
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query I
SELECT count(*) FROM mixed_codec WHERE lookup_key = 43 AND residual = 'keep'
----
1

# A single candidate set crossing an ordinary and a guarded RowGroup must inspect both segments.
statement ok
PRAGMA force_compression = 'uncompressed'

statement ok
CREATE TABLE mixed_codec_cross(lookup_key INTEGER, residual VARCHAR, payload VARCHAR)

statement ok
INSERT INTO mixed_codec_cross
SELECT 42, CASE WHEN i = 0 THEN 'keep' ELSE 'reject' END, repeat('d', 100)
FROM range(32) t(i)
UNION ALL
SELECT i % 41, 'reject', repeat('e', 100)
FROM range(2016) t(i)

statement ok
FORCE CHECKPOINT

statement ok
PRAGMA force_compression = 'dict_fsst'

statement ok
INSERT INTO mixed_codec_cross
SELECT 42, CASE WHEN i = 0 THEN 'keep' ELSE 'reject' END, repeat('f', 100)
FROM range(64) t(i)
UNION ALL
SELECT i % 41, 'reject', repeat('g', 100)
FROM range(1984) t(i)

statement ok
FORCE CHECKPOINT

statement ok
CREATE INDEX mixed_codec_cross_lookup ON mixed_codec_cross(lookup_key)

query II
EXPLAIN ANALYZE SELECT payload FROM mixed_codec_cross WHERE lookup_key = 42 AND residual = 'keep'
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query I
SELECT count(*) FROM mixed_codec_cross WHERE lookup_key = 42 AND residual = 'keep'
----
2

statement ok
USE codec_admission

statement ok
DETACH mixed
