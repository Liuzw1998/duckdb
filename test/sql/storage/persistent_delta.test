# name: test/sql/storage/persistent_delta.test
# description: Persist sparse INTEGER/BIGINT updates as a cumulative delta
# group: [storage]

load {TEST_DIR}/persistent_delta.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET debug_verify_blocks=true;

statement ok
CREATE TABLE t(a INTEGER, b BIGINT);

statement ok
INSERT INTO t
SELECT CASE WHEN i % 17 = 0 THEN NULL ELSE i::INTEGER END, i::BIGINT
FROM range(200000) tbl(i);

statement ok
CHECKPOINT;

statement ok
UPDATE t SET a=1000000000, b=9000000000 WHERE rowid IN (1, 3, 5, 100000, 150000);

statement ok
UPDATE t SET a=NULL, b=-9000000000 WHERE rowid=7;

statement ok
CHECKPOINT;

query III
SELECT rowid, a, b FROM t WHERE rowid IN (1, 3, 5, 7, 100000, 150000) ORDER BY rowid;
----
1	1000000000	9000000000
3	1000000000	9000000000
5	1000000000	9000000000
7	NULL	-9000000000
100000	1000000000	9000000000
150000	1000000000	9000000000

restart

statement ok
SET debug_verify_blocks=true;

query III
SELECT rowid, a, b FROM t WHERE rowid IN (1, 3, 5, 7, 100000, 150000) ORDER BY rowid;
----
1	1000000000	9000000000
3	1000000000	9000000000
5	1000000000	9000000000
7	NULL	-9000000000
100000	1000000000	9000000000
150000	1000000000	9000000000

query I
SELECT count(*) FROM t WHERE a=1000000000;
----
5

statement ok
BEGIN;

statement ok
UPDATE t SET a=42, b=43 WHERE rowid=1;

statement ok
ROLLBACK;

statement ok
CHECKPOINT;

query II
SELECT a, b FROM t WHERE rowid=1;
----
1000000000	9000000000

statement ok
UPDATE t SET a=NULL, b=43 WHERE rowid=3;

statement ok
CHECKPOINT;

restart

query III
SELECT rowid, a, b FROM t WHERE rowid IN (1, 3, 7) ORDER BY rowid;
----
1	1000000000	9000000000
3	NULL	43
7	NULL	-9000000000

statement ok
CREATE TABLE nested(i INTEGER, s STRUCT(x INTEGER, y VARCHAR));

statement ok
INSERT INTO nested
SELECT i, {'x': i, 'y': 'v' || i::VARCHAR} FROM range(200000) tbl(i);

statement ok
CHECKPOINT;

statement ok
UPDATE nested SET i=1000000000 WHERE rowid IN (1, 3, 100000);

statement ok
CHECKPOINT;

statement ok
UPDATE nested SET s={'x': -1, 'y': 'changed'} WHERE rowid=7;

statement ok
CHECKPOINT;

restart

query III
SELECT rowid, i, s FROM nested WHERE rowid IN (1, 3, 7, 100000) ORDER BY rowid;
----
1	1000000000	{'x': 1, 'y': v1}
3	1000000000	{'x': 3, 'y': v3}
7	7	{'x': -1, 'y': changed}
100000	1000000000	{'x': 100000, 'y': v100000}

statement ok
CREATE TABLE transient_base AS SELECT i::INTEGER AS v FROM range(10000) r(i);

statement ok
CHECKPOINT;

statement ok
INSERT INTO transient_base VALUES (10000);

statement ok
UPDATE transient_base SET v=-1 WHERE v=0;

statement ok
CHECKPOINT;

restart

query III
SELECT count(*), min(v), max(v) FROM transient_base;
----
10001	-1	10000
